---
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideSections from '../../components/GuideSections.astro';
import { guideSections, guides } from '../../lib/library';

const chapters = guides.map((guide, index) => ({ guide, anchor: `intro-${index}`, title: guide.name.split(' (')[0] }));
---

<LibraryLayout title="Giới thiệu Cờ Liên Quân" description="Luật chơi và hướng dẫn nhập môn Cờ Liên Quân từ Bách khoa." section="intro">
  <Breadcrumbs items={[{ label: 'Trang chủ', href: '/' }, { label: 'Thư viện', href: '/quan-co/' }, { label: 'Giới thiệu' }]} />
  <header class="page-heading">
    <h1 class="page-title">Làm quen với <em class="intro-game-title">Cờ Liên Quân</em></h1>
    <p class="page-description">Đọc các hướng dẫn nhập môn từ Bách khoa Cờ Liên Quân.</p>
  </header>
  <nav class="intro-index" aria-labelledby="intro-index-title">
    <h2 id="intro-index-title">Mục lục</h2>
    <ol>
      {chapters.map(({ title, anchor }) => <li><a href={`#${anchor}`}>{title}</a></li>)}
    </ol>
  </nav>
  <div class="guide-content intro-chapters">
    {chapters.map(({ guide, anchor }) => (
      <article id={anchor} class="content-block">
        <h2>{guide.name}</h2>
        <GuideSections sections={guideSections(guide)} titleLevel="h3" />
        <a href={guide.href}>Mở hồ sơ hướng dẫn</a>
      </article>
    ))}
  </div>
  <nav class="page-links" aria-label="Tra cứu tiếp trong thư viện">
    <a href="/quan-co/">Xem quân cờ</a>
    <a href="/nhiem-vu/">Xem nhiệm vụ</a>
  </nav>
</LibraryLayout>
