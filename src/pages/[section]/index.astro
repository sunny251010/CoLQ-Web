---
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogSearch from '../../components/CatalogSearch.astro';
import RecordCard from '../../components/RecordCard.astro';
import { augmentTiers, catalog, categories, categoryRecords, libraryCategories } from '../../lib/library';
import type { InferGetStaticPropsType } from 'astro';

export function getStaticPaths() {
  return libraryCategories.map((category) => ({
    params: { section: categories[category].path.slice(1, -1) },
    props: { category },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { category } = Astro.props;
const info = categories[category];
const records = categoryRecords(category);
const filters = {
  heroes: [
    { name: 'price', label: 'Giá vàng', options: [...new Set(records.map(({ price }) => price))].filter((price) => price != null).sort((a, b) => a - b).map((value) => ({ value: String(value), label: `${value} vàng` })) },
    { name: 'trait', label: 'Phe / Nghề', options: catalog.records.filter((record) => record.category === 'traits').sort((a, b) => a.name.localeCompare(b.name, 'vi')).map(({ id, name }) => ({ value: id, label: name })) },
  ],
  equipment: [{ name: 'group', label: 'Nhóm trang bị', options: catalog.equipmentGroups.map(({ id, label }) => ({ value: id, label })) }],
  traits: [{ name: 'group', label: 'Phân loại', options: ['Phe', 'Nghề'].map((value) => ({ value, label: value })) }],
  augments: [{ name: 'quality', label: 'Nhóm lõi', options: [...augmentTiers] }],
  quests: [{ name: 'reward', label: 'Phần thưởng', options: [{ value: 'gold', label: 'Vàng' }, { value: 'chess', label: 'Quân cờ' }, { value: 'equipment', label: 'Trang bị' }] }],
}[category];
const groups = category === 'equipment' ? catalog.equipmentGroups.map(({ id, label, anchor }) => ({
  label,
  anchor,
  tone: undefined,
  rows: records.filter((record) => record.equipmentGroup?.id === id)
    .sort((a, b) => (a.equipmentGroup?.position ?? 0) - (b.equipmentGroup?.position ?? 0)),
})) : category === 'augments' ? augmentTiers.map(({ id, value, label, tone }) => ({
  label, anchor: id, tone, rows: records.filter((record) => record.quality === value),
})) : [];
---

<LibraryLayout title={info.title} description={info.summary} section={category}>
  <Breadcrumbs items={[{ label: 'Trang chủ', href: '/' }, { label: 'Thư viện', href: '/quan-co/' }, { label: info.title }]} />
  <header class="page-heading">
    <div class="catalog-title"><h1 class="page-title">{info.title}</h1><span class="catalog-total">{records.length} hồ sơ</span></div>
    <p class="page-description">{info.summary}. Mùa của bộ dữ liệu này chưa được xác minh.</p>
  </header>
  <CatalogSearch label={`Tìm trong ${info.title.toLocaleLowerCase('vi')}`} count={records.length} filters={filters}>
    <Fragment slot="after-filters">
      {groups.length > 0 && <nav class="catalog-jumps" aria-label="Đi đến nhóm" data-group-jumps>
        {groups.map(({ label, anchor, rows, tone }) => (
          <a href={`#${anchor}`} data-group-jump={anchor} data-tone={tone}>{label}<span data-group-count>{rows.length}</span></a>
        ))}
      </nav>}
    </Fragment>
    {groups.length > 0 ? groups.map(({ anchor, label, rows, tone }, groupIndex) => (
      <section class="catalog-group" id={anchor} data-filter-group data-tone={tone} aria-labelledby={`${anchor}-heading`}>
        <header class="section-heading">
          <h2 id={`${anchor}-heading`}>{label}</h2>
          <span class="muted"><span data-group-count>{rows.length}</span> hồ sơ</span>
        </header>
        <div class:list={['record-grid', `record-grid--${category}`]}>
          {rows.map((record, index) => <RecordCard record={record} eager={groupIndex === 0 && index < 4} />)}
        </div>
      </section>
    )) : (
      <div class:list={['record-grid', `record-grid--${category}`]}>
        {records.map((record, index) => <RecordCard record={record} eager={index < 4} />)}
      </div>
    )}
  </CatalogSearch>
</LibraryLayout>
