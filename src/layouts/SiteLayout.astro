---
import SiteNav from '../components/SiteNav.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  current?: string;
  indexable?: boolean;
  library?: boolean;
}

const { title, description, current, indexable = true, library = false } = Astro.props;
const brand = 'Cẩm Nang Cờ Liên Quân';
const documentTitle = Astro.url.pathname === '/' ? brand : `${title} | ${brand}`;
const canonical = Astro.site && indexable ? new URL(Astro.url.pathname, Astro.site) : undefined;
const accountPage = /^\/(?:admin|tai-khoan|dang-nhap|creator)(?:\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="vi" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!accountPage && <ClientRouter />}
    <link rel="preload" href="/fonts/noto-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-vietnamese-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {!canonical && <meta name="robots" content="noindex, follow" />}
    {canonical && <>
      <link rel="canonical" href={canonical} />
      <meta property="og:url" content={canonical} />
    </>}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content="vi_VN" />
    <link rel="icon" href="data:," />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#noi-dung">Đến nội dung chính</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${brand}, trang chủ`}>
          <span class="brand-mark" aria-hidden="true">♞</span>
          <span>Cẩm Nang<strong>Cờ Liên Quân</strong></span>
        </a>
        <div class="desktop-nav"><SiteNav current={current} /></div>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <SiteNav current={current} />
        </details>
      </div>
    </header>
    <main class:list={['container', library && 'library-main']} id="noi-dung" tabindex="-1">
      <span id="main"></span>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>{brand}</strong>
          <p>Dự án cộng đồng độc lập của người hâm mộ Cờ Liên Quân.</p>
        </div>
        <nav aria-label="Thông tin bổ sung">
          <a href="/thu-vien/">Thư viện</a>
          <a href="/du-lieu/">Nguồn dữ liệu</a>
          <a href="/lien-he/">Liên hệ / Báo lỗi</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-line);
  }

  .header-inner {
    display: grid;
  }

  .brand {
    grid-area: 1 / 1;
    z-index: 1;
    align-self: start;
    justify-self: start;
    margin-block-start: 0.625rem;
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    gap: var(--space-2);
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--color-muted);
    text-decoration: none;
  }

  .brand strong {
    display: block;
    font-size: 1rem;
    color: var(--color-text);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    color: var(--color-accent);
    font-size: 1.5rem;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-nav {
    grid-area: 1 / 1;
    padding-block: 0.625rem;
  }

  .mobile-nav summary {
    align-content: center;
    min-height: var(--target-min);
    width: fit-content;
    margin-inline-start: auto;
    padding-inline: var(--space-3);
    cursor: pointer;
    border-radius: var(--radius);
  }

  .mobile-nav[open] summary {
    background: var(--color-raised);
  }

  .mobile-nav :global(nav) {
    margin-block-start: var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  main {
    padding-block: clamp(1.25rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  }

  .library-main { max-width: 98rem; padding: 0; }

  #main {
    display: block;
  }

  .site-footer {
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    flex-wrap: wrap;
  }

  .footer-inner strong { color: var(--color-text); }
  .footer-inner p { margin-block: var(--space-1) 0; }
  .footer-inner nav { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  .footer-inner a { display: inline-flex; align-items: center; min-height: var(--target-min); }

  @media (min-width: 64rem) {
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 4.5rem;
    }

    .brand {
      align-self: center;
      margin: 0;
    }

    .desktop-nav { display: block; }
    .mobile-nav { display: none; }
  }
</style>

<script>
  function hideBrokenImage(target: EventTarget | null) {
    if (target instanceof HTMLImageElement && target.hasAttribute('data-game-image')) {
      target.hidden = true;
    }
  }

  document.addEventListener('error', (event) => hideBrokenImage(event.target), true);
  document.addEventListener('astro:page-load', () => {
    for (const image of document.querySelectorAll<HTMLImageElement>('img[data-game-image]')) {
      if (image.complete && !image.naturalWidth) hideBrokenImage(image);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey || event.defaultPrevented) return;
    const target = event.target;
    if (target instanceof Element && target.closest('input, select, textarea, [contenteditable]')) return;
    const search = document.querySelector<HTMLInputElement>('input[type="search"]');
    if (search) {
      event.preventDefault();
      search.focus();
    }
  });
</script>
