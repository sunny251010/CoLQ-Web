---
import SiteNav from '../components/SiteNav.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="data:," />
    <title>{title} | CoLQ</title>
  </head>
  <body>
    <a class="skip-link" href="#noi-dung">Đến nội dung chính</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="CoLQ, trang chủ">CoLQ</a>
        <div class="desktop-nav"><SiteNav /></div>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <SiteNav />
        </details>
      </div>
    </header>
    <main class="container" id="noi-dung" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">CoLQ là dự án cộng đồng Cờ Liên Quân do người hâm mộ xây dựng.</div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-line);
  }

  .header-inner {
    display: grid;
  }

  .brand {
    grid-area: 1 / 1;
    z-index: 1;
    align-self: start;
    justify-self: start;
    margin-block-start: 0.625rem;
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-size: 1.35rem;
    font-weight: 750;
    color: var(--color-accent);
    text-decoration: none;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-nav {
    grid-area: 1 / 1;
    padding-block: 0.625rem;
  }

  .mobile-nav summary {
    align-content: center;
    min-height: var(--target-min);
    width: fit-content;
    margin-inline-start: auto;
    padding-inline: var(--space-3);
    cursor: pointer;
    border-radius: var(--radius);
  }

  .mobile-nav[open] summary {
    background: var(--color-raised);
  }

  .mobile-nav :global(nav) {
    margin-block-start: var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  main {
    padding-block: clamp(2.5rem, 9vw, 7rem);
  }

  .site-footer {
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 64rem) {
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 4rem;
    }

    .brand {
      align-self: center;
      margin: 0;
    }

    .desktop-nav { display: block; }
    .mobile-nav { display: none; }
  }
</style>
